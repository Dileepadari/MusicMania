# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
env/

# Logs
logs/
*.log

# Editor and OS cruft
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.sw?

# Merge and patch leftovers
*.orig
*.rej
*.bak

# Any dotfile ending in .env, whatever it is called. Match the shape, not the
# name, because the name is the part that gets typed wrong.
*.env
!.env.example

# The database is built, never committed. It was tracked once, on the assumption
# that it was only catalogue data, and it carried real accounts and their
# passwords with it. The catalogue now lives in data/catalogue.json, which a diff
# can actually review. Recreate the database with:
#   flask --app run init-db
data/*.db
data/*.sqlite
data/*.db-journal
data/*.db-wal
data/*.db-shm
